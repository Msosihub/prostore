# TEMPLATE ONLY: never source as a working configuration. Do not commit filled copies.
NODE_ENV=production
# Required at BUILD time for the immutable single-process Ubuntu package.
NIMBOYA_IMMUTABLE_RELEASE=true
# Approved clean operational database; never reuse a credential posted in chat.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=https://nimboya.com
NEXT_PUBLIC_SERVER_URL=https://nimboya.com
# Review reverse-proxy trust configuration separately; not enabled here.
ZENOPAY_API_KEY=
AT_API_KEY=
# Existing live adapter currently uses BmContractors / BM SECURITY; verify account/sender.
AT_SMS_MODE=live
# Needed for existing UploadThing upload workflows, not basic catalogue reads.
UPLOADTHING_TOKEN=
# Newly approved random 32-256 character worker credential; same value in worker.env.
NIMBOYA_WORKER_SECRET=
NIMBOYA_PAYMENT_WORKER_MODE=disabled
NIMBOYA_ORDER_WORKER_MODE=disabled
NIMBOYA_SELLER_WORKER_MODE=disabled
# Optional Google login only if existing account configuration is intentionally retained.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
