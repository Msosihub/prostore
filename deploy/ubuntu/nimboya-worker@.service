[Unit]
Description=Nimboya bounded %i worker (explicit activation required)
After=nimboya.service

[Service]
Type=oneshot
User=nimboya
Group=nimboya
WorkingDirectory=/opt/nimboya/current
# Worker credential only; do not give the caller database/provider credentials.
EnvironmentFile=/etc/nimboya/worker.env
ExecStart=/usr/bin/node /opt/nimboya/current/scripts/invoke-local-worker.cjs %i --invoke
TimeoutStartSec=80
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
