generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([identifier, token])
}

model User {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String           @default("NO_NAME")
  email                 String?          @unique
  emailVerified         DateTime?        @db.Timestamp(6)
  phone                 String?          @unique
  whatsapp              String?
  role                  UserRole         @default(BUYER)
  location              String?
  mapLat                Float?
  mapLng                Float?
  isVerified            Boolean          @default(false)
  image                 String?
  password              String?
  address               Json?            @db.Json
  paymentMethod         String?
  createdAt             DateTime         @default(now()) @db.Timestamp(6)
  updatedAt             DateTime         @updatedAt
  avatar                String?
  phoneVerified         DateTime?
  country               String?
  onboarded             Boolean          @default(false)
  paymentPhone          String?
  chatwootAgentId       Int?
  chatwootContactId     Int?
  account               Account[]
  Admin                 Admin?
  Cart                  Cart[]
  BuyerConversations    Conversation[]   @relation("BuyerConversations")
  SupplierConversations Conversation[]   @relation("SupplierConversations")
  messagesSent          Message[]        @relation("SentMessages")
  Notification          Notification[]
  Order                 Order[]
  PayoutRequest         PayoutRequest[]
  ProductComment        ProductComment[]
  Review                Review[]
  session               Session[]
  Supplier              Supplier?
}

model Cart {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  sessionCartId String
  items         Json[]   @default([]) @db.Json
  itemsPrice    Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  shippingPrice Decimal  @db.Decimal(12, 2)
  taxPrice      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  isBuyNow      Boolean  @default(false)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @db.Uuid
  shippingAddress Json        @db.Json
  paymentMethod   String
  paymentResult   Json?       @db.Json
  itemsPrice      Decimal     @db.Decimal(12, 2)
  shippingPrice   Decimal     @db.Decimal(12, 2)
  taxPrice        Decimal     @db.Decimal(12, 2)
  totalPrice      Decimal     @db.Decimal(12, 2)
  isPaid          Boolean     @default(false)
  paidAt          DateTime?   @db.Timestamp(6)
  isDelivered     Boolean     @default(false)
  deliveredAt     DateTime?   @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @db.Timestamp(6)
  paymentStatus   String      @default("PENDING")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderitems      OrderItem[]
}

model OrderItem {
  orderId      String           @db.Uuid
  productId    String           @db.Uuid
  qty          Int
  price        Decimal          @db.Decimal(12, 2)
  name         String
  slug         String
  image        String
  supplierId   String?          @default("")
  deliveredAt  DateTime?        @db.Timestamp(6)
  isDelivered  Boolean          @default(false)
  supplierName String?          @default("")
  payoutAt     DateTime?        @db.Timestamp(6)
  payoutStatus ItemPayoutStatus @default(ESCROW)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  status               OrderItemStatus @default(PREPARING)
  dispatchNote         String?
  dispatchedAt         DateTime?       @db.Timestamp(6)
  buyerDeliveryComment String?
  buyerDeliveryRating  Int?
  rejectedAt           DateTime?       @db.Timestamp(6)
  rejectionReason      String?

  @@id([orderId, productId], map: "orderitems_orderId_productId_pk")
}

enum OrderItemStatus {
  PAID
  PREPARING
  DISPATCHED
  DELIVERED
  REJECTED
  RETURNED
  CANCELLED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model OrderItemEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @db.Uuid
  productId String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model OrderDeliveryFeedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @db.Uuid
  productId  String   @db.Uuid
  buyerId    String   @db.Uuid
  supplierId String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  @@unique([orderId, productId])
}

model ReturnRequest {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String              @db.Uuid
  productId  String              @db.Uuid
  buyerId    String              @db.Uuid
  supplierId String              @db.Uuid
  reason     String
  status     ReturnRequestStatus @default(REQUESTED)
  adminNote  String?
  createdAt  DateTime            @default(now()) @db.Timestamp(6)
  updatedAt  DateTime            @updatedAt

  @@unique([orderId, productId])
}

model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  productId          String   @db.Uuid
  rating             Int
  title              String
  description        String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  description String?
  image       String?
  products    Product[]
}

model Category {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_en       String        @unique
  name_sw       String
  image         String?
  createdAt     DateTime      @default(now()) @db.Timestamp(6)
  description   String        @default("")
  parentId      String?       @db.Uuid
  updatedAt     DateTime      @default(now()) @db.Timestamp(6)
  sortOrder     Int           @default(0)
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_en     String
  name_sw     String
  categoryId  String    @db.Uuid
  image       String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  category    Category  @relation(fields: [categoryId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @db.Uuid
  action     String
  details    Json?
  createdAt  DateTime @default(now())
  entityId   String?  @db.Uuid
  entityType String?
  reason     String?
  name       String   @default("NO_NAME")
  admin      Admin    @relation(fields: [adminId], references: [id])
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String           @unique(map: "product_slug_idx")
  description    String
  images         String[]
  banner         String?
  price          Decimal          @default(0) @db.Decimal(12, 2)
  stock          Int              @default(0)
  color          String?
  size           String?
  supplierId     String           @db.Uuid
  rating         Decimal          @default(0) @db.Decimal(3, 2)
  numReviews     Int              @default(0)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamp(6)
  brandId        String           @db.Uuid
  categoryId     String           @db.Uuid
  subcategoryId  String           @db.Uuid
  thumbnail      String?
  tags           String[]
  videoUrl       String?          @default("")
  Conversation   Conversation[]
  Message        Message[]
  OrderItem      OrderItem[]
  brand          Brand            @relation(fields: [brandId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory      @relation(fields: [subcategoryId], references: [id])
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  ProductComment ProductComment[]
  pricingTiers   ProductPricing[]
  ProductVariant ProductVariant[]
  Review         Review[]

  Inquiry Inquiry[]
}

model ProductPricing {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  minQty    Int
  price     Decimal @db.Decimal(12, 2)
  product   Product @relation(fields: [productId], references: [id])
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt
  content        String    @default("")
  inquiryId      String?   @db.Uuid
  productId      String?   @db.Uuid
  replyToId      String?   @db.Uuid
  seen           Boolean   @default(false)
  sentAt         DateTime? @default(now()) @db.Timestamp(6)
  moderated      Boolean   @default(false)
  moderatedAt    DateTime?
  moderatedBy    String?
  moderationNote String?

  chatwootId        Int?         @unique
  chatwootStatus    String?      @default("pending")
  chatwootMessageId Int?
  attachments       Attachment[]
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  inquiry           Inquiry?     @relation(fields: [inquiryId], references: [id])
  product           Product?     @relation(fields: [productId], references: [id])
  replyTo           Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies           Message[]    @relation("MessageReplies")
  sender            User         @relation("SentMessages", fields: [senderId], references: [id])
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  name      String?
  messageId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  mimeType  String?
  message   Message  @relation(fields: [messageId], references: [id])
}

model Supplier {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String              @unique
  phone             String?
  companyName       String?
  location          String?
  nation            String?
  logo              String?
  website           String?
  isVerified        Boolean             @default(false)
  yearsActive       Int                 @default(1)
  rating            Decimal             @default(0.0) @db.Decimal(3, 2)
  deliveryRate      Int                 @default(0)
  responseTime      String?
  avatar            String?
  about             String?
  banner            String?
  description       String?
  tagLine           String?
  gallery           Json?
  username          String?             @unique
  bannerUrl         String?
  businessHours     Json?
  businessType      String?
  country           String?
  label             String?
  createdAt         DateTime            @default(now()) @db.Timestamp(6)
  updatedAt         DateTime            @default(now()) @db.Timestamp(6)
  verifiedAt        DateTime?           @db.Timestamp(6)
  verifiedBy        String?             @db.Uuid
  pendingBalance    Decimal             @default(0) @db.Decimal(12, 2)
  walletBalance     Decimal             @default(0) @db.Decimal(12, 2)
  certifications    Certification[]
  PayoutRequest     PayoutRequest[]
  products          Product[]
  Quote             Quote[]
  user              User                @relation(fields: [userId], references: [id])
  SupplierAnalytics SupplierAnalytics[]
  SupplierDocument  SupplierDocument[]
  SupplierPolicy    SupplierPolicy[]
}

model SupplierLedger {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId  String  @db.Uuid
  orderId     String  @db.Uuid
  orderItemId String? @db.Uuid

  type      String // ESCROW_CREDIT, ESCROW_RELEASE, PAYOUT, REFUND, ADJUSTMENT
  amount    Decimal @db.Decimal(12, 2)
  status    String // PENDING, COMPLETED, FAILED
  reference String? @unique
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model Certification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String    @db.Uuid
  image           String
  label           String
  certNumber      String    @default("")
  validUntil      DateTime?
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  documentId      String?   @db.Uuid
  type            String?
  updatedAt       DateTime  @default(now()) @db.Timestamp(6)
  verified        Boolean   @default(false)
  visibleToBuyers Boolean   @default(true)
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
}

model Conversation {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId                String    @db.Uuid
  supplierId             String    @db.Uuid
  productId              String?   @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamp(6)
  updatedAt              DateTime  @updatedAt
  chatwootContactId      Int?
  chatwootConversationId Int?      @unique
  chatwootInboxId        Int?
  chatwootLastMessageAt  DateTime?
  buyer                  User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  Product                Product?  @relation(fields: [productId], references: [id])
  supplier               User      @relation("SupplierConversations", fields: [supplierId], references: [id])
  Inquiry                Inquiry[]
  messages               Message[]

  @@unique([buyerId, supplierId])
}

model Inquiry {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @db.Uuid
  quantity       Decimal?      @db.Decimal(12, 2)
  unit           String?
  variant        String?
  targetPrice    Decimal?      @db.Decimal(12, 2)
  customization  Boolean?
  shippingTerm   String?
  needSamples    Boolean?      @default(false)
  notes          String?
  status         InquiryStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt
  details        String?
  subject        String?
  buyerId        String?
  productId      String?       @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  Message      Message[]
  Quote        Quote[]
}

model Quote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId    String   @db.Uuid
  supplierId   String   @db.Uuid
  pricePerUnit Decimal  @db.Decimal(12, 2)
  moq          Int
  leadTime     String?
  validity     String?
  notes        String?
  attachments  Json?
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt
  buyerId      String?
  productId    String?
  quantity     Decimal? @db.Decimal(12, 2)
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
}

model ProductVariant {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  sku       String? @unique
  name      String
  price     Decimal @db.Decimal(12, 2)
  stock     Int     @default(0)
  image     String?
  product   Product @relation(fields: [productId], references: [id])
}

model PayoutRequest {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId    String       @db.Uuid
  userId        String       @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  paymentMethod String
  accountNumber String
  status        PayoutStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime     @updatedAt
  supplier      Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])
}

model SupplierPolicy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String   @db.Uuid
  type           String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  additionalInfo Json?    @db.Json
  supplier       Supplier @relation(fields: [supplierId], references: [id])
}

model ProductComment {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String           @db.Uuid
  userId    String           @db.Uuid
  parentId  String?          @db.Uuid
  content   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  parent    ProductComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   ProductComment[] @relation("CommentReplies")
  product   Product          @relation(fields: [productId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model SupplierAnalytics {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String   @db.Uuid
  metric     String
  value      Int
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  content   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SupplierDocument {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String         @db.Uuid
  label           String
  name            String
  type            String?
  fileUrl         String
  files           Json?          @db.Json
  verified        Boolean        @default(false)
  uploadedAt      DateTime       @default(now()) @db.Timestamp(6)
  certNumber      String?
  description     String?
  source          String?
  validUntil      DateTime?
  visibleToBuyers Boolean        @default(false)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?        @db.Uuid
  status          DocumentStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @db.Timestamp(6)
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
}

model Admin {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  role      String     @default("ADMIN")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  AuditLog  AuditLog[]
}

model Banner {
  id        String       @id @default(uuid()) @db.Uuid
  image     String
  link      String?
  data      Json?
  type      String?
  createdAt DateTime     @default(now())
  subtitle  String?
  title     String?
  updatedAt DateTime     @updatedAt
  isActive  Boolean      @default(false)
  mode      BannerMode   @default(MANUAL)
  text      String?
  category  String       @default("")
  items     BannerItem[]
}

model BannerItem {
  id        String  @id @default(uuid()) @db.Uuid
  image     String
  title     String?
  link      String
  bannerId  String  @db.Uuid
  productId String? @default("")
  banner    Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
}

model BotMessage {
  id        String   @id @default(uuid())
  phone     String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model LeadLink {
  id        String   @id @default(uuid())
  phone     String
  service   String
  leadName  String
  createdAt DateTime @default(now())
  notified  Boolean  @default(false)
}

model Contact {
  id          String      @id @default(cuid())
  phone       String      @unique
  name        String?
  isBlocked   Boolean     @default(false)
  isOwner     Boolean     @default(false)
  isVIP       Boolean     @default(false)
  type        ContactType @default(UNKNOWN)
  lastMessage String?
  lastSeen    DateTime    @updatedAt
  createdAt   DateTime    @default(now())
}

model access_tokens {
  id         BigInt   @id @default(autoincrement())
  owner_type String?  @db.VarChar
  owner_id   BigInt?
  token      String?  @unique(map: "index_access_tokens_on_token") @db.VarChar
  created_at DateTime @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)

  @@index([owner_type, owner_id], map: "index_access_tokens_on_owner_type_and_owner_id")
}

model account_users {
  id             BigInt    @id @default(autoincrement())
  account_id     BigInt?
  user_id        BigInt?
  role           Int?      @default(0)
  inviter_id     BigInt?
  created_at     DateTime  @db.Timestamp(6)
  updated_at     DateTime  @db.Timestamp(6)
  active_at      DateTime? @db.Timestamp(6)
  availability   Int       @default(0)
  auto_offline   Boolean   @default(true)
  custom_role_id BigInt?

  @@unique([account_id, user_id], map: "uniq_user_id_per_account_id")
  @@index([account_id], map: "index_account_users_on_account_id")
  @@index([custom_role_id], map: "index_account_users_on_custom_role_id")
  @@index([user_id], map: "index_account_users_on_user_id")
}

model accounts {
  id                    Int      @id @default(autoincrement())
  name                  String   @db.VarChar
  created_at            DateTime @db.Timestamp(6)
  updated_at            DateTime @db.Timestamp(6)
  locale                Int?     @default(0)
  domain                String?  @db.VarChar(100)
  support_email         String?  @db.VarChar(100)
  feature_flags         BigInt   @default(0)
  auto_resolve_duration Int?
  limits                Json?    @default("{}")
  custom_attributes     Json?    @default("{}")
  status                Int?     @default(0)

  @@index([status], map: "index_accounts_on_status")
}

model action_mailbox_inbound_emails {
  id               BigInt   @id @default(autoincrement())
  status           Int      @default(0)
  message_id       String   @db.VarChar
  message_checksum String   @db.VarChar
  created_at       DateTime @db.Timestamp(6)
  updated_at       DateTime @db.Timestamp(6)

  @@unique([message_id, message_checksum], map: "index_action_mailbox_inbound_emails_uniqueness")
}

model active_storage_attachments {
  id                   BigInt               @id @default(autoincrement())
  name                 String               @db.VarChar
  record_type          String               @db.VarChar
  record_id            BigInt
  blob_id              BigInt
  created_at           DateTime             @db.Timestamp(6)
  active_storage_blobs active_storage_blobs @relation(fields: [blob_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_c3b3935057")

  @@unique([record_type, record_id, name, blob_id], map: "index_active_storage_attachments_uniqueness")
  @@index([blob_id], map: "index_active_storage_attachments_on_blob_id")
}

model active_storage_blobs {
  id                             BigInt                           @id @default(autoincrement())
